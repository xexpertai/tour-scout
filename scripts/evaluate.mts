/**
 * Offline evaluation of the product's own claims (no Qloo, model or network calls). Reads the three
 * captured demo runs in public/presets/ and the hand-written guard red-team set in
 * docs/eval/guard-cases.json, and checks:
 *
 *   1. Cited:    every Qloo value on a plan names a request that exists in that plan's Sources.
 *   2. Labelled: every model sentence cites only real requests (AI) or is labelled GENERAL/TEMPLATE.
 *   3. Drivable: every leg of every route, in its driving order, is within the day-drive rule.
 *   4. Sized:    every opener or support act is within the size rule, or carries the visible flag.
 *   5. Earned:   each recorded route-check proposal, re-checked here independently of the server:
 *                the added city came from that check's own Qloo requests, is stronger than the stop
 *                it replaces, and the changed route is still drivable; the verdict quotes the data.
 *   6. Guarded:  the guard against the red-team set (withhold vs keep), with every miss listed.
 *
 *   npm run eval              prints the report
 *   npm run eval -- --write   also refreshes the generated block in docs/EVALUATION.md
 */
import { readFileSync, writeFileSync } from "node:fs";
import { insightGuard, type Insight } from "../src/lib/guard.ts";
import { MARKETS } from "../src/lib/markets.ts";
import { planGuardOpts } from "../src/lib/tour/plan.ts";
import { PRESETS, type CapturedRun } from "../src/lib/tour/presets.ts";
import { MAX_LEG_KM, ROAD_FACTOR, bestOrder, legs } from "../src/lib/tour/region.ts";
import type { FollowUp, TourPlan } from "../src/lib/tour/types.ts";

const root = new URL("../", import.meta.url);
export const EVAL_START = "<!-- evaluation:start (generated by `npm run eval -- --write` from public/presets/*.json and docs/eval/*.json) -->";
export const EVAL_END = "<!-- evaluation:end -->";

type Case = { preset: string; field: string; text: string; expect: "withhold" | "keep"; category: string };
const pct = (a: number, b: number) => (b ? `${Math.round((a / b) * 1000) / 10}%` : "n/a");
const s1 = (n: number) => (Math.round(n * 1000) / 10).toFixed(1);
const clean = (s: string) => s.replace(/\s*\(sample\)$/, "");

export function loadRun(slug: string): { run: CapturedRun; plan: TourPlan; check?: FollowUp } {
  const run = JSON.parse(readFileSync(new URL(`public/presets/${slug}.json`, root), "utf8")) as CapturedRun;
  const typeOf = (e: { event: unknown }) => (e.event as { type?: string }).type;
  const plan = (run.events.find((e) => typeOf(e) === "plan")!.event as { plan: TourPlan }).plan;
  const answer = run.scout?.events.find((e) => typeOf(e) === "answer")?.event as { followUp: FollowUp } | undefined;
  return { run, plan, check: answer?.followUp };
}

/** Every Qloo-derived value on a plan, with the request it cites. */
function qlooValues(plan: TourPlan): { what: string; evidence: string }[] {
  const out: { what: string; evidence: string }[] = [];
  const push = (what: string, evidence?: string) => out.push({ what, evidence: evidence ?? "" });
  plan.fan.tags.forEach((t) => push(`tag ${t.name}`, t.evidence));
  plan.fan.alsoLikes.forEach((a) => push(`also likes (${a.domain})`, a.evidence));
  if (plan.fan.demographics) push("demographics", plan.fan.demographics.evidence);
  for (const c of plan.candidates ?? []) push(`city ${c.name}`, c.evidence);
  for (const s of plan.stops) {
    push(`stop ${s.city.name}`, s.city.evidence);
    if (s.city.hotspot) push(`hotspot ${s.city.name}`, s.city.hotspot.evidence);
    if (s.cluster) push(`cluster ${s.cluster.name}`, s.cluster.evidence);
    s.venues.forEach((v) => push(`room ${v.name}`, v.evidence));
    if (s.opener) {
      push(`opener ${s.opener.name}`, s.opener.evidence);
      if (s.opener.overlap) push(`overlap ${s.opener.name}`, s.opener.overlap.evidence);
    }
  }
  return out;
}

function insights(plan: TourPlan): Insight[] {
  return [plan.summary, ...plan.theme, ...plan.merch, ...plan.risks, ...plan.stops.flatMap((s) => [s.why, s.pitch])].filter((x): x is Insight => Boolean(x));
}

const located = (cs: { lat?: number; lng?: number }[]) => cs.filter((c) => c.lat !== undefined && c.lng !== undefined).map((c) => ({ lat: c.lat!, lng: c.lng! }));
const routeLegs = (cs: { lat?: number; lng?: number }[]) => { const pts = located(cs); return legs(pts, bestOrder(pts)); };

export type PlanRow = {
  act: string; values: number; cited: number; ai: number; aiCited: number; general: number; template: number; withheld: number;
  legs: number; legsOk: number; longestRoadKm: number; openers: number; openersInRule: number; openersFlagged: number; openersUnflaggedOver: number;
  requests: number;
};
export type CheckRow = { act: string; requests: number; serverChecks: number; agentChose: number; outcome: string; checks: { name: string; ok: boolean }[] };

export function evaluatePlan(plan: TourPlan): PlanRow {
  const ids = new Set(plan.sources.map((s) => s.id));
  const values = qlooValues(plan);
  const texts = insights(plan);
  const ai = texts.filter((t) => t.kind === "interpretation");
  const ordered = [...plan.stops].sort((a, b) => a.order - b.order).map((s) => s.city);
  const pts = located(ordered);
  const ls = legs(pts, pts.map((_, i) => i));
  const openers = plan.stops.map((s) => s.opener).filter((o): o is NonNullable<typeof o> => Boolean(o));
  const inRule = (o: (typeof openers)[number]) => o.popularity !== undefined && o.sizeCap !== undefined && o.popularity <= o.sizeCap;
  return {
    act: plan.artist.name, values: values.length, cited: values.filter((v) => ids.has(v.evidence)).length,
    ai: ai.length, aiCited: ai.filter((t) => t.evidence.length > 0 && t.evidence.every((e) => ids.has(e))).length,
    general: texts.filter((t) => t.kind === "general").length, template: texts.filter((t) => t.kind === "template").length, withheld: plan.withheld.length,
    legs: ls.length, legsOk: ls.filter((km) => km <= MAX_LEG_KM).length, longestRoadKm: Math.round((Math.max(...ls) * ROAD_FACTOR) / 10) * 10,
    openers: openers.length, openersInRule: openers.filter(inRule).length, openersFlagged: openers.filter((o) => !inRule(o) && o.oversize).length,
    openersUnflaggedOver: openers.filter((o) => !inRule(o) && !o.oversize).length,
    requests: plan.sources.length,
  };
}

export function evaluateCheck(plan: TourPlan, f: FollowUp): CheckRow {
  const ids = new Set(f.sources.map((s) => s.id));
  const checks: { name: string; ok: boolean }[] = [];
  const p = f.proposal;
  const add = p?.add ?? [];
  const removed = (p?.remove ?? []).map((id) => plan.stops.find((s) => s.stopId === id));
  if (add.length || removed.length) {
    checks.push({ name: "every added city came from this check's own Qloo requests", ok: add.every((c) => ids.has(c.evidence)) });
    checks.push({ name: "every removed stop is on the plan", ok: removed.every(Boolean) });
    const next = [...plan.stops.filter((s) => !p!.remove.includes(s.stopId)).map((s) => s.city), ...add];
    checks.push({ name: "the changed route keeps 2–6 stops", ok: next.length >= 2 && next.length <= 6 });
    checks.push({ name: `every leg of the changed route is within ${MAX_LEG_KM} km straight-line`, ok: routeLegs(next).every((km) => km <= MAX_LEG_KM) });
    checks.push({ name: "each added city scores above the stop it replaces", ok: add.every((c, i) => !removed[i] || c.affinity > removed[i]!.city.affinity) });
    checks.push({ name: "the verdict quotes the added and removed scores as recorded", ok: add.every((c) => f.answer.text.includes(s1(c.affinity))) && removed.every((r) => r && f.answer.text.includes(s1(r.city.affinity))) });
  } else {
    // "The route holds": no city the check scored within a day's drive beats the weakest stop.
    const weakest = [...plan.stops].sort((a, b) => a.city.affinity - b.city.affinity)[0];
    const stopNames = new Set(plan.stops.map((s) => clean(s.city.name)));
    const seen = (f.pins ?? []).filter((c) => !stopNames.has(clean(c.name)));
    const others = plan.stops.filter((s) => s !== weakest).map((s) => s.city);
    const drivableStronger = seen.filter((c) => c.affinity > weakest.city.affinity && routeLegs([...others, c]).every((km) => km <= MAX_LEG_KM));
    checks.push({ name: "no city the check scored is both stronger than the weakest stop and within a day's drive", ok: drivableStronger.length === 0 });
    checks.push({ name: "the verdict names the weakest stop with its recorded score", ok: f.answer.text.includes(`${clean(weakest.city.name)} (${s1(weakest.city.affinity)})`) });
  }
  const outcome = p ? `proposes ${p.summary}` : "route holds";
  return { act: plan.artist.name, requests: f.sources.length, serverChecks: f.serverChecks ?? 0, agentChose: f.sources.length - (f.serverChecks ?? 0), outcome, checks };
}

export function evaluateGuard(cases: Case[]) {
  const plans = new Map(PRESETS.map((p) => [p.slug, loadRun(p.slug).plan]));
  const results = cases.map((c) => {
    const plan = plans.get(c.preset)!;
    const stops = plan.stops.map((s) => clean(s.city.name).toLowerCase().split(",")[0]);
    const offRoute = MARKETS.map((m) => m.name).filter((n) => !stops.includes(n.toLowerCase().split(",")[0]));
    const { guard } = insightGuard(new Set(plan.sources.map((s) => s.id)), false, { ...planGuardOpts(plan), offRoute });
    const kept = Boolean(guard(c.field, { text: c.text, evidence: ["Q1"] }));
    return { ...c, withheld: !kept };
  });
  const unsafe = results.filter((r) => r.expect === "withhold");
  const safe = results.filter((r) => r.expect === "keep");
  const tp = unsafe.filter((r) => r.withheld).length;
  const fp = safe.filter((r) => r.withheld).length;
  return { results, unsafe: unsafe.length, safe: safe.length, tp, fp, missed: unsafe.filter((r) => !r.withheld), wronglyWithheld: safe.filter((r) => r.withheld) };
}

export function evaluationMarkdown(): string {
  const slugs = PRESETS.map((p) => p.slug);
  const runs = slugs.map(loadRun);
  const rows = runs.map((r) => evaluatePlan(r.plan));
  const checks = runs.filter((r) => r.check).map((r) => evaluateCheck(r.plan, r.check!));
  const load = (f: string) => (JSON.parse(readFileSync(new URL(`docs/eval/${f}`, root), "utf8")) as { cases: Case[] }).cases;
  const g = evaluateGuard(load("guard-cases.json"));
  const h = evaluateGuard(load("guard-holdout.json"));
  const sum = (k: keyof PlanRow) => rows.reduce((a, r) => a + (r[k] as number), 0);
  const allChecks = checks.flatMap((c) => c.checks);
  const L: string[] = [];
  L.push("| Claim | Check | Result |", "| --- | --- | --- |");
  L.push(`| Every number cites its Qloo request | Qloo values on the 3 demo plans whose Q-id exists in that plan's Sources | **${sum("cited")} of ${sum("values")}** (${pct(sum("cited"), sum("values"))}) |`);
  L.push(`| Model text is labelled honestly | AI-labelled sentences that cite only real Q-ids (the rest are labelled GENERAL or TEMPLATE) | **${sum("aiCited")} of ${sum("ai")}** AI; ${sum("general")} GENERAL, ${sum("template")} TEMPLATE, ${sum("withheld")} withheld by the guard |`);
  L.push(`| Routes are drivable | Legs within ${MAX_LEG_KM} km straight-line (about ${Math.round((MAX_LEG_KM * ROAD_FACTOR) / 10) * 10} km by road) | **${sum("legsOk")} of ${sum("legs")}** legs; longest by road: ${rows.map((r) => `${r.act} ≈ ${r.longestRoadKm} km`).join(", ")} |`);
  L.push(`| Openers are sized to the act | Openers or support acts within the size rule, or shown with the "above your size fit" flag | **${sum("openersInRule") + sum("openersFlagged")} of ${sum("openers")}** (${sum("openersInRule")} within the rule, ${sum("openersFlagged")} flagged, ${sum("openersUnflaggedOver")} over the rule without a flag) |`);
  L.push(`| The agent's proposals are earned | Recorded route checks re-checked here, independently of the server | **${allChecks.filter((c) => c.ok).length} of ${allChecks.length}** checks pass over ${checks.length} route checks |`);
  const guardRow = (name: string, x: typeof g) => `| The guard withholds overclaims | ${name}: ${x.unsafe} sentences that should be withheld, ${x.safe} that should be kept | **${x.tp} of ${x.unsafe}** withheld (recall ${pct(x.tp, x.unsafe)}); **${x.fp} of ${x.safe}** ordinary sentences wrongly withheld (precision ${pct(x.tp, x.tp + x.fp)}) |`;
  L.push(guardRow("Held-out red-team set (scored only after the fixes)", h));
  L.push(guardRow("First red-team set (its misses were fixed, so this is now a regression set)", g));
  L.push("");
  L.push("**Per demo plan**", "", "| Demo | Qloo requests | Qloo values cited | AI sentences cited | Legs within the rule | Openers in rule / flagged |", "| --- | --- | --- | --- | --- | --- |");
  for (const r of rows) L.push(`| ${r.act} | ${r.requests} | ${r.cited} / ${r.values} | ${r.aiCited} / ${r.ai} | ${r.legsOk} / ${r.legs} | ${r.openersInRule} / ${r.openersFlagged} of ${r.openers} |`);
  L.push("", "**Route checks** (re-checked from the recordings)", "", "| Demo | Outcome | Qloo requests (server / agent's choice) | Checks |", "| --- | --- | --- | --- |");
  for (const c of checks) L.push(`| ${c.act} | ${c.outcome} | ${c.requests} (${c.serverChecks} / ${c.agentChose}) | ${c.checks.map((x) => `${x.ok ? "pass" : "FAIL"}: ${x.name}`).join("<br>")} |`);
  L.push("", "**Guard red-team sets, by category** (withheld / should be withheld)", "", "| Category | Held-out set | First set |", "| --- | --- | --- |");
  const cats = [...new Set([...h.results, ...g.results].filter((r) => r.expect === "withhold").map((r) => r.category))];
  const cell = (x: typeof g, c: string) => { const xs = x.results.filter((r) => r.expect === "withhold" && r.category === c); return xs.length ? `${xs.filter((r) => r.withheld).length} / ${xs.length}` : "–"; };
  for (const c of cats) L.push(`| ${c} | ${cell(h, c)} | ${cell(g, c)} |`);
  const missed = [...h.missed.map((m) => ({ ...m, set: "held-out" })), ...g.missed.map((m) => ({ ...m, set: "first set" }))];
  const wrong = [...h.wronglyWithheld.map((m) => ({ ...m, set: "held-out" })), ...g.wronglyWithheld.map((m) => ({ ...m, set: "first set" }))];
  L.push("", `**Missed by the guard (${missed.length})**, kept here as known gaps:`, "");
  for (const m of missed) L.push(`- ${m.category} (${m.set}): "${m.text}"`);
  if (!missed.length) L.push("- none");
  L.push("", `**Ordinary sentences wrongly withheld (${wrong.length})**:`, "");
  for (const m of wrong) L.push(`- ${m.set}: "${m.text}"`);
  if (!wrong.length) L.push("- none");
  return L.join("\n");
}

export function withEvaluation(doc: string, block: string): string {
  const a = doc.indexOf(EVAL_START), b = doc.indexOf(EVAL_END);
  if (a < 0 || b < 0) throw new Error("docs/EVALUATION.md has no evaluation markers");
  return `${doc.slice(0, a + EVAL_START.length)}\n${block}\n${doc.slice(b)}`;
}

if (import.meta.url === `file://${process.argv[1]}`) {
  const md = evaluationMarkdown();
  console.log(md);
  if (process.argv.includes("--write")) {
    const file = new URL("docs/EVALUATION.md", root);
    writeFileSync(file, withEvaluation(readFileSync(file, "utf8"), md));
    console.error("docs/EVALUATION.md updated");
  }
}
