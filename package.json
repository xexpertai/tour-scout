{
  "name": "taste-advisor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3898",
    "build": "next build",
    "start": "next start -p 3898",
    "lint": "eslint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/**/*.test.mts\"",
    "qloo:key": "node scripts/set-qloo-key.mjs",
    "qloo:verify": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-qloo.mts",
    "qloo:verify-tour": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-tour.mts",
    "presets:capture": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/capture-presets.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.3.8",
    "ngeohash": "^0.6.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT"
}
