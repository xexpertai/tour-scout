# Copy to .env.local (git-ignored). Never commit real values.
# Tour plan text (one model call per run). Primary: Claude; fallback: Gemini; last resort: templated text.
LLM_PROVIDER=claude
# Deliberately not ANTHROPIC_API_KEY, so no other tool picks it up.
CLAUDE_API_KEY=replace-me
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# GEMINI_API_KEY=replace-me
# LLM_DAILY_CAP=40           model calls per UTC day; afterwards plans use templated text

# Qloo: prefer `npm run qloo:key` (hidden input) or `qloo setup --qloo` instead of editing by hand.
# QLOO_API_KEY=replace-with-your-event-credential
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# Optional
# DATA_DIR=/data              writable dir for share links, the LLM budget counter and geocoding cache
# QLOO_CONCURRENCY=3          parallel qloo processes
# QLOO_MOCK=1                 force sample data
# QLOO_MOCK_DELAY_MS=800      simulate Qloo latency in mock mode
# TOUR_RUNS_PER_HOUR=4        per-client live tours
# RESOLVES_PER_HOUR=40        per-client artist searches
# FOLLOWUPS_PER_HOUR=15       per-client scout questions and applies
# TOUR_DAILY_CAP=150          server-wide live tours per UTC day
# MAX_STORED_PLANS=1000       share-link plans kept under DATA_DIR
# NOMINATIM_USER_AGENT="your-app/1.0 (contact URL)"
